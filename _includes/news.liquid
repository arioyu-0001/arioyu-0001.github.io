<div class="news">
  {% assign news = site.news | reverse %}
  {% if news.size > 0 %}
    {% assign visible_count = news.size %}
    {% if include.limit and page.announcements.limit %}
      {% assign visible_count = page.announcements.limit %}
    {% endif %}
    {% assign recent = news | slice: 0, visible_count %}
    {% include news_table.liquid items=recent %}
    {% if news.size > visible_count %}
      {% assign older = news | slice: visible_count, news.size %}
      <details class="older-news">
        <summary>Earlier news ({{ older.size }})</summary>
        {% include news_table.liquid items=older %}
      </details>
    {% endif %}
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
